<?xml version="1.0" encoding="UTF-8"?>
<!--
CutIn: a target in lane TgtLane performs a full lane change (3.5 m) into the Ego lane (-2).
R171 Annex 4 4.2.5.2.6 (01 series) / Euro NCAP VA v1.2 2.1.4: indicated TTC = TTC when the target has
finished the lane change (rear centre in the middle of the VUT lane).  The grid file sets TgtStartS and
LcStart so that this TTC equals the grid value if the Ego kept its initial speed (open-loop definition).
Project choice: sinusoidal lateral profile (esmini LaneChangeAction) instead of the two constant-radius arcs
of the regulation; the lane-change duration is matched, the peak lateral acceleration is not.
Generated by scripts/make_scenarios.py from dcas/xosc.py (do not edit by hand).  Speeds m/s, distances m, times s.
-->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="2" date="2026-10-28T00:00:00" description="Cut-in from the adjacent lane, parameterised" author="Luo Wenjie (AI-assisted)"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoSpeed" parameterType="double" value="33.333333"/>
    <ParameterDeclaration name="EgoStartS" parameterType="double" value="100.0"/>
    <ParameterDeclaration name="SimEndTime" parameterType="double" value="20.0"/>
    <ParameterDeclaration name="ExtCtrl" parameterType="boolean" value="false"/>
    <ParameterDeclaration name="CaseId" parameterType="string" value="default"/>
    <ParameterDeclaration name="TgtSpeed" parameterType="double" value="19.444444"/>
    <ParameterDeclaration name="TgtStartS" parameterType="double" value="160.0"/>
    <ParameterDeclaration name="TgtLane" parameterType="int" value="-3"/>
    <ParameterDeclaration name="LcStart" parameterType="double" value="4.0"/>
    <ParameterDeclaration name="LcTime" parameterType="double" value="3.086"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="highway_straight.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="VUT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.75"/>
          <Dimensions width="1.85" length="4.6" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.325"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.325"/>
        </Axles>
        <Properties/>
      </Vehicle>
      <ObjectController>
        <Controller name="DCAS_ExternalController">
          <Properties>
            <Property name="esminiController" value="ExternalController"/>
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="Target">
      <Vehicle name="GVT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.3" y="0.0" z="0.75"/>
          <Dimensions width="1.8" length="4.0" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.325"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.325"/>
        </Axles>
        <Properties/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-2" offset="0.0" s="$EgoStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$EgoSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="$ExtCtrl" lateral="$ExtCtrl"/>
            </ControllerAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Target">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="$TgtLane" offset="0.0" s="$TgtStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$TgtSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Story">
      <Act name="Act">
        <ManeuverGroup name="TargetGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Target"/>
          </Actors>
          <Maneuver name="TargetManeuver">
            <Event name="CutIn" priority="override" maximumExecutionCount="1">
              <Action name="CutInAction">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="$LcTime" dynamicsDimension="time"/>
                      <LaneChangeTarget>
                        <AbsoluteTargetLane value="-2"/>
                      </LaneChangeTarget>
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="CutInStart" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="$LcStart" rule="greaterOrEqual"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EndTime" delay="0" conditionEdge="none">
          <ByValueCondition>
            <SimulationTimeCondition value="$SimEndTime" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>

<?xml version="1.0" encoding="UTF-8"?>
<!--
LatProbe: a vehicle in lane AdjLane moves towards the Ego lane by ProbeOffset (positive = left) inside its
own lane (LaneChangeAction to the same lane with targetLaneOffset), then returns at ProbeBackStart.
It never enters the Ego lane by more than ProbeOffset - 0.85 m; any Ego braking for it is a false activation.
Generated by scripts/make_scenarios.py from dcas/xosc.py (do not edit by hand).  Speeds m/s, distances m, times s.
-->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="2" date="2026-10-28T00:00:00" description="Non-threatening lateral approach of an adjacent vehicle (false-braking study), parameterised" author="Luo Wenjie (AI-assisted)"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoSpeed" parameterType="double" value="33.333333"/>
    <ParameterDeclaration name="EgoStartS" parameterType="double" value="100.0"/>
    <ParameterDeclaration name="SimEndTime" parameterType="double" value="20.0"/>
    <ParameterDeclaration name="ExtCtrl" parameterType="boolean" value="false"/>
    <ParameterDeclaration name="CaseId" parameterType="string" value="default"/>
    <ParameterDeclaration name="AdjSpeed" parameterType="double" value="25.0"/>
    <ParameterDeclaration name="AdjStartS" parameterType="double" value="150.0"/>
    <ParameterDeclaration name="AdjLane" parameterType="int" value="-3"/>
    <ParameterDeclaration name="ProbeOffset" parameterType="double" value="0.8"/>
    <ParameterDeclaration name="ProbeStart" parameterType="double" value="4.0"/>
    <ParameterDeclaration name="ProbeTime" parameterType="double" value="2.0"/>
    <ParameterDeclaration name="ProbeBackStart" parameterType="double" value="7.0"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="highway_straight.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="VUT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.75"/>
          <Dimensions width="1.85" length="4.6" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.325"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.325"/>
        </Axles>
        <Properties/>
      </Vehicle>
      <ObjectController>
        <Controller name="DCAS_ExternalController">
          <Properties>
            <Property name="esminiController" value="ExternalController"/>
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="Adj">
      <Vehicle name="GVT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.3" y="0.0" z="0.75"/>
          <Dimensions width="1.8" length="4.0" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.325"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.325"/>
        </Axles>
        <Properties/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-2" offset="0.0" s="$EgoStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$EgoSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="$ExtCtrl" lateral="$ExtCtrl"/>
            </ControllerAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Adj">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="$AdjLane" offset="0.0" s="$AdjStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$AdjSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Story">
      <Act name="Act">
        <ManeuverGroup name="AdjGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Adj"/>
          </Actors>
          <Maneuver name="AdjManeuver">
            <Event name="ProbeOut" priority="override" maximumExecutionCount="1">
              <Action name="ProbeOutAction">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction targetLaneOffset="$ProbeOffset">
                      <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="$ProbeTime" dynamicsDimension="time"/>
                      <LaneChangeTarget>
                        <RelativeTargetLane entityRef="Adj" value="0"/>
                      </LaneChangeTarget>
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ProbeOutStart" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="$ProbeStart" rule="greaterOrEqual"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="ProbeBack" priority="override" maximumExecutionCount="1">
              <Action name="ProbeBackAction">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction targetLaneOffset="0.0">
                      <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="$ProbeTime" dynamicsDimension="time"/>
                      <LaneChangeTarget>
                        <RelativeTargetLane entityRef="Adj" value="0"/>
                      </LaneChangeTarget>
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ProbeBackStart" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="$ProbeBackStart" rule="greaterOrEqual"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EndTime" delay="0" conditionEdge="none">
          <ByValueCondition>
            <SimulationTimeCondition value="$SimEndTime" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
